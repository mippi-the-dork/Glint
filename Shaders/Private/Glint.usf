// Glint v0.8.6: filtered HDR region detection, temporal source selection, and authored optics. No engine shader source copied.
// Coordinates are source-viewport-relative; all resources remain inside RDG.
#include "/Engine/Private/Common.ush"

Texture2D<float4> HDRScene;
RWTexture2D<float4> BrightOutput;
RWTexture2D<float4> GhostOutput;
RWTexture2D<float4> CandidateOutput;
RWTexture2D<float4> DetectionOutput;
Texture2D<float4> DetectionTexture;
RWTexture2D<float4> SourcesOutput;
Texture2D<float4> CandidateTexture;
Texture2D<float4> SourceHistory;
Texture2D<float4> SourcePositions;
RWTexture2D<float4> SceneOutput;
Texture2D<float4> BrightTexture;
Texture2D<float4> FlareTexture;
int2 SourceMin;
int2 SourceSize;
int2 BrightSize;
uint SampleStride;
uint DetectionRadius;
int2 FullSize;
int2 CandidateSize;
float BrightThreshold;
float KneeWidth;
float PeakMix;
float MaxContribution;
float GhostStrength;
float StreakStrength;
float ChromaticShift;
float GhostSpacing;
float StreakLength;
uint GhostCount;
uint ElementCount;
uint MaxSources;
float SourceMinBrightness;
float SourceSeparation;
float SourceGroupingRadius;
float SourceSmoothing;
float SourcePersistence;
float SourceHysteresis;
float SourcePositionDeadZone;
float SourceCameraMotion;
float4x4 SourcePreviousToCurrentClip;
uint UseSourceReprojection;
float4x4 SourceSunWorldToClipNoAA;
uint AtmosphereSunMode;
uint AtmosphereLightIndex;
float SourceRelativeScoreFloor;
float SourceReplacementRatio;
uint SourceReplacementFrames;
uint ResetSourceHistory;
uint UseSourcePositions;
uint DebugSources;
float SourceEdgeFade;
float SourceGain;
float AuthoredEnergyLimit;
uint UseSourceAutomatic;

struct FGlintRuntimeElement
{
    float4 ColorStrength;
    float4 Geometry;
    float4 Offset;
    float4 Shape;
    float4 Detail;
};
StructuredBuffer<FGlintRuntimeElement> FlareElements;
float FlareIntensity;
uint DebugBrightPass;
uint DebugFlareOnly;
RWTexture2D<float4> PreviewOutput;
int2 PreviewSize;
float2 PreviewSourceUV;
float4 PreviewSourceColor;
float PreviewExposure;
uint PreviewElementCount;

float GlintLum(float3 c) { return dot(max(c, 0.0), float3(0.2126, 0.7152, 0.0722)); }
// Out-of-frame flare samples must be black, NOT clamped to the nearest border
// texel. Clamping duplicates a bright edge pixel across many ghost/streak taps,
// creating horizontal/vertical bars when the source approaches any viewport edge.
float3 GlintLoadBrightOrBlack(int2 p)
{
    if (any(p < int2(0, 0)) || any(p >= BrightSize))
    {
        return float3(0.0, 0.0, 0.0);
    }
    return BrightTexture.Load(int3(p, 0)).rgb;
}

// Manual bilinear filter with zero outside the valid image. This preserves a
// fractional footprint at the image edge instead of either stretching a border
// texel indefinitely or abruptly dropping a bright subpixel-sized highlight.
float3 GlintSampleBright(float2 uv)
{
    float2 pos = uv * float2(BrightSize) - 0.5;
    int2 p0 = int2(floor(pos));
    float2 alpha = frac(pos);
    float3 a = GlintLoadBrightOrBlack(p0);
    float3 b = GlintLoadBrightOrBlack(p0 + int2(1, 0));
    float3 c = GlintLoadBrightOrBlack(p0 + int2(0, 1));
    float3 d = GlintLoadBrightOrBlack(p0 + int2(1, 1));
    return lerp(lerp(a, b, alpha.x), lerp(c, d, alpha.x), alpha.y);
}

[numthreads(8,8,1)]
void GlintExtractCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= uint2(BrightSize))) return;
    int2 base = SourceMin + int2(id.xy) * int(SampleStride);
    float3 average = 0.0;
    float3 highest = 0.0;
    float peak = -1.0;
    float validCount = 0.0;
    const int2 sourceEnd = SourceMin + SourceSize;
    // Scan only real source pixels, even for an incomplete 4x4 cell on the
    // right/bottom edge. Never replicate border pixels into the padded area.
    [unroll] for (int y = 0; y < 4; ++y)
    [unroll] for (int x = 0; x < 4; ++x)
    {
        int2 p = base + int2(x, y);
        if (x < int(SampleStride) && y < int(SampleStride) && all(p < sourceEnd))
        {
            float3 color = max(HDRScene.Load(int3(p, 0)).rgb, 0.0);
            average += color;
            validCount += 1.0;
            float lum = GlintLum(color);
            if (lum > peak) { peak = lum; highest = color; }
        }
    }
    average /= max(validCount, 1.0);
    float3 mixed = lerp(average, highest, saturate(PeakMix));
    float lum = GlintLum(mixed);
    float knee = max(BrightThreshold * KneeWidth, 0.001);
    float response = saturate((lum - BrightThreshold + knee) / (2.0 * knee));
    response = max(lum - BrightThreshold, 0.0) + response * response * knee;
    // Preserve raw HDR peak luminance in alpha for source selection. RGB still
    // represents the user-thresholded flare field. A moving/smeared highlight
    // must not disappear solely because averaged RGB falls below the flare
    // threshold while an actual HDR source remains visible.
    BrightOutput[id.xy] = float4(mixed * (min(response, MaxContribution) / max(lum, 0.0001)), max(peak, 0.0));
}

// Spatially filtered *detection* only. Never blur the HDR scene, the final
// flare, or the raw peak channel used by release/acquisition gates.
// A single 3x3/5x5 low-resolution pass stabilizes TAA subpixel fluctuations.
[numthreads(8,8,1)]
void GlintBuildDetectionCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= uint2(BrightSize))) return;
    float weighted = 0.0;
    float sum = 0.0;
    int radius = int(min(DetectionRadius, 2u));
    [loop] for (int y=-2; y<=2; ++y)
    [loop] for (int x=-2; x<=2; ++x)
    {
        if (abs(x)>radius || abs(y)>radius) continue;
        int2 pixel = int2(id.xy) + int2(x,y);
        if (any(pixel < 0) || any(pixel >= BrightSize)) continue;
        float w = float((radius + 1 - abs(x)) * (radius + 1 - abs(y)));
        weighted += BrightTexture.Load(int3(pixel,0)).a * w;
        sum += w;
    }
    float rawPeak = BrightTexture.Load(int3(id.xy,0)).a;
    float smoothLum = weighted / max(sum, 1.0);
    DetectionOutput[id.xy] = float4(smoothLum, rawPeak, 0.0, 1.0);
}

// The rank balances extremely bright *small* emitters with coherent spatial
// support. Raw HDR peak survives smoothing and still controls source gates.
// A diffuse cloud/large flat bright area receives no extra sharpness bonus.
float GlintDetectionRank(float peak, float region)
{
    float foreground = max(peak, 0.0);
    float filtered = max(region, 0.0);
    float contrast = saturate((foreground - filtered) / max(filtered, 0.1));
    // Peak evidence dominates broad, low-contrast illumination. The region
    // term still helps large legitimate emitters, but no longer overwhelms a
    // smaller HDR sun disk simply because a cloud spans more pixels.
    return sqrt(foreground) * (0.65 + 1.65 * contrast) + 0.30 * sqrt(filtered);
}

// Parallel 32x32-tile reduction retains the best region *score*, not simply
// the largest individual pixel. Adjacent bright texels contribute to a stable
// larger neighborhood centroid, including across tile boundaries.
groupshared float GlintTileScore[64];
groupshared float GlintTileRawPeak[64];
groupshared float2 GlintTileRawPosition[64];
groupshared float GlintTilePeak[64];
groupshared float2 GlintTilePosition[64];
[numthreads(8,8,1)]
void GlintFindCandidatesCS(uint3 group : SV_GroupID, uint3 lane : SV_GroupThreadID)
{
    uint index = lane.y * 8 + lane.x;
    float bestScore = 0.0;
    float bestLum = 0.0;
    float rawLum = 0.0;
    float2 rawUV = float2(0,0);
    float2 bestUV = float2(0,0);
    [unroll] for (uint y = 0; y < 4; ++y)
    [unroll] for (uint x = 0; x < 4; ++x)
    {
        int2 p = int2(group.xy * 32 + lane.xy * 4 + uint2(x,y));
        if (all(p < BrightSize))
        {
            float lum = BrightTexture.Load(int3(p,0)).a;
            float region = DetectionTexture.Load(int3(p,0)).r;
            if (lum > rawLum) { rawLum = lum; rawUV = (float2(p)+0.5)/float2(BrightSize); }
            float score = GlintDetectionRank(lum, region);
            if (score > bestScore || (score == bestScore && lum > bestLum))
            {
                bestScore = score;
                bestLum = lum;
                bestUV = (float2(p) + 0.5) / float2(BrightSize);
            }
        }
    }
    GlintTileRawPeak[index] = rawLum;
    GlintTileRawPosition[index] = rawUV;
    GlintTileScore[index] = bestScore;
    GlintTilePeak[index] = bestLum;
    GlintTilePosition[index] = bestUV;
    GroupMemoryBarrierWithGroupSync();
    [unroll] for (uint stride = 32; stride >= 1; stride >>= 1)
    {
        if (index < stride && (GlintTileScore[index+stride] > GlintTileScore[index] ||
            (GlintTileScore[index+stride] == GlintTileScore[index] && GlintTilePeak[index+stride] > GlintTilePeak[index])))
        {
            GlintTileScore[index] = GlintTileScore[index+stride];
            GlintTilePeak[index] = GlintTilePeak[index+stride];
            GlintTilePosition[index] = GlintTilePosition[index+stride];
        }
        if (index < stride && GlintTileRawPeak[index+stride] > GlintTileRawPeak[index])
        {
            GlintTileRawPeak[index] = GlintTileRawPeak[index+stride];
            GlintTileRawPosition[index] = GlintTileRawPosition[index+stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if (index == 0)
    {
        float2 weightedUV = 0.0;
        float totalWeight = 0.0;
        int2 center = int2(GlintTilePosition[0] * float2(BrightSize));
        // Region centroid uses smoothed illumination rather than one TAA peak.
        // Radial weighting prevents the centroid from sliding across the whole
        // sky when a broad, fairly uniform cloud is selected.
        [loop] for (int sy=-5; sy<=5; ++sy)
        [loop] for (int sx=-5; sx<=5; ++sx)
        {
            int2 pixel = center + int2(sx,sy);
            if (all(pixel >= 0) && all(pixel < BrightSize))
            {
                float region = DetectionTexture.Load(int3(pixel,0)).r;
                float weight = max(region - GlintTilePeak[0]*0.08, 0.0) /
                    (1.0 + 0.09 * float(sx*sx + sy*sy));
                weightedUV += (float2(pixel) + 0.5) * weight;
                totalWeight += weight;
            }
        }
        float2 regionCenterUV = totalWeight > 1e-5 ?
            weightedUV / totalWeight / float2(BrightSize) : GlintTilePosition[0];
        int2 peakPixel = clamp(int2(GlintTilePosition[0]*float2(BrightSize)),int2(0,0),BrightSize-1);
        float peakRegion = DetectionTexture.Load(int3(peakPixel,0)).r;
        // Compact sources stay near the measured HDR peak rather than being
        // dragged toward an adjacent cloud by the large filtered neighborhood.
        float compactness = saturate((GlintTilePeak[0] - peakRegion) / max(GlintTilePeak[0],0.1));
        float2 resultUV = lerp(regionCenterUV, GlintTilePosition[0], compactness);
        // Candidate.z is the original *unfiltered* HDR peak used for threshold
        // and intensity; candidate.w is independent region ranking evidence.
        CandidateOutput[uint2(group.x*2u,group.y)] = float4(resultUV, GlintTilePeak[0], GlintTileScore[0]);
        // A second raw-peak candidate protects tiny, intense lights when the
        // region winner in the same tile was a large bright cloud or ground
        // reflection. Both entries share one 32x32 reduction dispatch.
        int2 rawPixel = clamp(int2(GlintTileRawPosition[0]*float2(BrightSize)),int2(0,0),BrightSize-1);
        float rawRegion = DetectionTexture.Load(int3(rawPixel,0)).r;
        CandidateOutput[uint2(group.x*2u+1u,group.y)] = float4(
            GlintTileRawPosition[0],GlintTileRawPeak[0],
            GlintDetectionRank(GlintTileRawPeak[0],rawRegion));
    }
}

// Stable source chromaticity must come from raw HDR input, not Bright.rgb.
// Bright.rgb is thresholded and changes sharply with exposure/TAA reconstruction;
// using it as an emitter tint produced orange/pink/blue flashes at rest.
// Only 8 source slots sample this neighborhood (no per-pixel rendering cost).
float3 GlintSourceHDRTint(float2 normalizedUV, float peak)
{
    int2 center = SourceMin + int2(saturate(normalizedUV) * float2(SourceSize));
    int2 sceneMax = SourceMin + SourceSize - 1;
    float3 weighted = 0.0;
    float weightTotal = 0.0;
    [unroll] for (int y = -2; y <= 2; ++y)
    [unroll] for (int x = -2; x <= 2; ++x)
    {
        int2 samplePixel = clamp(center + int2(x,y), SourceMin, sceneMax);
        float3 hdr = max(HDRScene.Load(int3(samplePixel,0)).rgb, 0.0);
        float luminance = GlintLum(hdr);
        float weight = saturate((luminance - SourceMinBrightness * 0.20)
            / max(SourceMinBrightness, 0.02));
        weighted += hdr * weight;
        weightTotal += weight;
    }
    float3 average = weightTotal > 0.0001 ? weighted / weightTotal : float3(1,1,1);
    float largest = max(max(average.r,average.g),average.b);
    // Source luminance separately controls overall response. Keep sampled color
    // a *bounded emitter tint* so a single hot pixel cannot blow out all 32
    // authored elements or temporally change their opacity.
    float intensity = min(2.5, 0.20 + 0.45*sqrt(max(peak,0.0)));
    return average / max(largest, 0.0001) * intensity;
}

// Only called on missing tiled matches at a stationary viewpoint. If HDR is
// still present at the old UV, an unrelated brighter tile must not move it.
float GlintSourceLocalPeak(float2 normalizedUV)
{
    int2 center = SourceMin + int2(saturate(normalizedUV) * float2(SourceSize));
    int2 sceneMax = SourceMin + SourceSize - 1;
    float peak = 0.0;
    [unroll] for (int y=-2; y<=2; ++y)
    [unroll] for (int x=-2; x<=2; ++x)
    {
        int2 coord = clamp(center + int2(x,y), SourceMin, sceneMax);
        peak = max(peak, GlintLum(HDRScene.Load(int3(coord,0)).rgb));
    }
    return peak;
}

// Selected source history is three 8-wide rows:
//   row 0: normalized UV, HDR peak luminance, confidence (0..1)
//   row 1: last reliable HDR source RGB (avoids source-color loss when a
//          threshold or temporal reconstruction temporarily drops a candidate).
//   row 2: pending replacement UV, challenger rank, consecutive-frame count.
// Persistence is deliberately short; cuts and view-size changes reset history.
// Temporal stabilization keeps established sources in their original slots.
// New sources require the full gate; prior sources use a lower release gate.
// Both are measured from current HDR. Cached sources fade briefly during a
// dropout rather than asserting that an occluded source remains visible.
// Reproject a far-field source from the previous camera into the current
// unjittered clip frame. Reverse-Z depth 0 represents the infinitely distant
// direction, so camera translation does not manufacture artificial parallax.
float2 GlintReprojectSourceUV(float2 previousUV)
{
    if (UseSourceReprojection == 0u) return previousUV;
    float2 previousNDC = float2(previousUV.x*2.0-1.0,1.0-previousUV.y*2.0);
    float4 currentClip = mul(float4(previousNDC,0.0,1.0),SourcePreviousToCurrentClip);
    if (currentClip.w <= 1.0e-5) return previousUV;
    float2 currentUV = float2(0.5 + 0.5*currentClip.x/currentClip.w,
                               0.5 - 0.5*currentClip.y/currentClip.w);
    if (any(isnan(currentUV)) || any(abs(currentUV)>4.0)) return previousUV;
    return currentUV;
}

// Very bright, compact sources need a smaller grouping radius than broad
// cloud/terrain regions. The old global 0.125 UV grouping radius could suppress
// a sun disk even when five or more source slots were still unoccupied.
float GlintCandidateGroupingRadius(float2 uv, float peak, float broadRadius)
{
    int2 spot = clamp(int2(uv * float2(BrightSize)), int2(0,0), BrightSize-1);
    float filtered = DetectionTexture.Load(int3(spot,0)).r;
    float compactness = saturate((peak - filtered) / max(peak, 0.1));
    float compactWeight = smoothstep(0.25, 0.65, compactness);
    return lerp(broadRadius, SourceSeparation, compactWeight);
}

// Sky Atmosphere's directional-light index 0 is the deterministic sun anchor.
// Projection uses an infinite-distance direction (w=0), so translations of the
// camera do not induce false parallax. These view-uniform fields are supplied
// by UE 5.8's render thread and must not be fabricated from candidate maxima.
bool GlintProjectAtmosphereSun(out float2 sunUV)
{
    sunUV = float2(-1.0,-1.0);
    if (AtmosphereSunMode == 0u) return false;
    float3 sunIlluminance = AtmosphereLightIndex == 0u
        ? View.AtmosphereLightIlluminanceOuterSpace[0].rgb
        : View.AtmosphereLightIlluminanceOuterSpace[1].rgb;
    // UE can provide a default direction without an actual atmosphere light.
    // Its zero illuminance must never spawn a phantom sun.
    if (max(sunIlluminance.r,max(sunIlluminance.g,sunIlluminance.b)) <= 1.0e-5)
        return false;
    float3 sunDirection = AtmosphereLightIndex == 0u
        ? View.AtmosphereLightDirection[0].xyz
        : View.AtmosphereLightDirection[1].xyz;
    float dirSquared = dot(sunDirection,sunDirection);
    if (dirSquared < 0.1) return false;
    float4 sunClip = mul(float4(sunDirection * rsqrt(dirSquared),0.0), SourceSunWorldToClipNoAA);
    if (sunClip.w <= 1.0e-5) return false;
    sunUV = float2(0.5 + 0.5 * sunClip.x / sunClip.w,
                   0.5 - 0.5 * sunClip.y / sunClip.w);
    return all(sunUV >= float2(0.0,0.0)) && all(sunUV <= float2(1.0,1.0));
}

// Validate sunlight against live (pre-exposed) HDR from the CURRENT frame.
// The center sample is allowed a few reduced pixels of uncertainty, but the
// optical center remains the deterministic camera-projected direction.
// A diffuse cloud has a much less compact peak/background relationship.
bool GlintValidateAtmosphereSun(float2 sunUV, out float sunPeak)
{
    int2 center = clamp(int2(sunUV * float2(BrightSize)),int2(0,0),BrightSize-1);
    sunPeak = 0.0;
    [unroll] for (int y=-3; y<=3; ++y)
    [unroll] for (int x=-3; x<=3; ++x)
    {
        int2 samplePixel = clamp(center+int2(x,y),int2(0,0),BrightSize-1);
        sunPeak = max(sunPeak,DetectionTexture.Load(int3(samplePixel,0)).g);
    }
    const int2 offsets[8] = {
        int2(-8,0),int2(8,0),int2(0,-8),int2(0,8),
        int2(-6,-6),int2(6,-6),int2(-6,6),int2(6,6)
    };
    float background = 0.0;
    [unroll] for (int i=0;i<8;++i)
    {
        int2 samplePixel = clamp(center+offsets[i],int2(0,0),BrightSize-1);
        background += DetectionTexture.Load(int3(samplePixel,0)).r * 0.125;
    }
    return sunPeak >= max(SourceMinBrightness * 1.20, background * 1.35);
}

[numthreads(1,1,1)]
void GlintSelectSourcesCS(uint3 id : SV_DispatchThreadID)
{
    float4 previous[8];
    float3 previousColor[8];
    float4 previousChallenge[8];
    float4 resolvedChallenge[8];
    float4 resolved[8];
    float3 resolvedColor[8];
    [unroll] for (int k = 0; k < 8; ++k)
    {
        previous[k] = ResetSourceHistory != 0u ? 0.0 : SourceHistory.Load(int3(k,0,0));
        previousColor[k] = ResetSourceHistory != 0u ? 0.0 : SourceHistory.Load(int3(k,1,0)).rgb;
        previousChallenge[k] = ResetSourceHistory != 0u ? 0.0 : SourceHistory.Load(int3(k,2,0));
        resolvedChallenge[k] = 0.0;
        resolved[k] = 0.0;
        resolvedColor[k] = 0.0;
    }
    float grouping = max(SourceSeparation, SourceGroupingRadius);
    float motion = saturate(SourceCameraMotion);
    // At rest, keep the matching neighborhood small. During genuine camera
    // rotation, expand it so real emitter motion does not lag or disappear.
    // The predicted position already compensates for camera rotation. A 20%-of-screen
    // match radius allowed unrelated clouds to steal an emitter during motion.
    // Near-field translation without depth may reacquire after a brief fade.
    float reacquireRadius = lerp(max(0.020, SourcePositionDeadZone * 4.0), 0.060, motion);
    float releaseGate = SourceMinBrightness * clamp(SourceHysteresis, 0.25, 1.0);
    float strongestScore = 0.0;
    [loop] for (int y=0; y<CandidateSize.y; ++y)
    [loop] for (int x=0; x<CandidateSize.x; ++x)
    {
        float4 candidate = CandidateTexture.Load(int3(x,y,0));
        if (candidate.z >= SourceMinBrightness) strongestScore = max(strongestScore, candidate.w);
    }
    float acquisitionScoreFloor = strongestScore * saturate(SourceRelativeScoreFloor);

    // A sky sun may share a tile or grouping region with a cloud. Do NOT make
    // it compete for that region's candidate slot: use the projected sky-light
    // direction and require independent live HDR evidence of the visible disk.
    // Slot zero is stable by design; other detected sources use slots 1..7.
    float2 skySunUV = float2(-1.0,-1.0);
    if (GlintProjectAtmosphereSun(skySunUV))
    {
        float skySunPeak = 0.0;
        bool visibleSun = GlintValidateAtmosphereSun(skySunUV,skySunPeak);
        if (visibleSun || AtmosphereSunMode == 2u)
        {
            skySunPeak = max(skySunPeak, SourceMinBrightness);
            float confidence = previous[0].w > 0.10 &&
                distance(previous[0].xy,skySunUV) < 0.12
                ? min(1.0, previous[0].w + 0.18) : 0.60;
            resolved[0] = float4(skySunUV,skySunPeak,confidence);
            resolvedColor[0] = GlintSourceHDRTint(skySunUV,skySunPeak);
        }
        else if (previous[0].w > 0.10 &&
            distance(GlintReprojectSourceUV(previous[0].xy),skySunUV) < 0.08)
        {
            // A real sun temporarily behind a cloud fades rather than
            // teleporting to the next ranked ground reflection.
            float confidence = previous[0].w * saturate(SourcePersistence);
            if (confidence > 0.12)
            {
                resolved[0] = float4(skySunUV,previous[0].z,confidence);
                resolvedColor[0] = previousColor[0];
            }
        }
    }

    // First, protect old source slots against tile-rank changes and TAA
    // brightness jitter. A measured peak down to the release gate is valid.
    [loop] for (uint slot = 0u; slot < 8u; ++slot)
    {
        if (slot >= MaxSources) break;
        if (resolved[slot].w > 0.10) continue; // reserved validated atmospheric sun
        if (previous[slot].w <= 0.10) continue;
        float2 predicted = GlintReprojectSourceUV(previous[slot].xy);
        float bestDistance = reacquireRadius;
        float2 measured = predicted;
        float measuredPeak = 0.0;
        bool hasMatch = false;
        [loop] for (int y = 0; y < CandidateSize.y; ++y)
        [loop] for (int x = 0; x < CandidateSize.x; ++x)
        {
            float4 c = CandidateTexture.Load(int3(x,y,0));
            if (c.w <= 0.0 || c.z < releaseGate) continue;
            float dist = distance(c.xy, predicted);
            if (dist > reacquireRadius) continue;
            bool alreadyClaimed = false;
            const float candidateGrouping = GlintCandidateGroupingRadius(c.xy, c.z, grouping);
            [unroll] for (int j = 0; j < 8; ++j)
                if (resolved[j].w > 0.10 && distance(c.xy, resolved[j].xy) < candidateGrouping)
                    alreadyClaimed = true;
            if (alreadyClaimed) continue;
            // Nearest plausible candidate wins, not the brightest. A cloud,
            // specular pixel or TAA reconstruction 100px away may outshine the
            // original tile for a frame; that is not a source identity change.
            if (!hasMatch || dist < bestDistance-0.0005 ||
                (abs(dist-bestDistance) <= 0.0005 && c.z > measuredPeak))
            {
                hasMatch = true;
                bestDistance = dist;
                measured = c.xy;
                measuredPeak = c.z;
            }
        }
        if (hasMatch)
        {
            float dist = distance(measured, predicted);
            // Camera reprojection carries expected motion. Do not snap all the way to
            // a different tile peak just because the camera is rotating.
            float response = clamp(SourceSmoothing, 0.08, 0.55);
            float2 uv = dist <= SourcePositionDeadZone ? predicted :
                lerp(predicted, measured, response);
            float3 tint = GlintSourceHDRTint(measured, measuredPeak);
            float3 color = lerp(previousColor[slot], tint, lerp(0.08,0.30,motion));
            float brightness = lerp(previous[slot].z, measuredPeak, 0.18);
            float confidence = lerp(previous[slot].w, 1.0, 0.25);
            resolved[slot] = float4(uv, brightness, confidence);
            resolvedColor[slot] = color;
        }
        else
        {
            float2 predicted = GlintReprojectSourceUV(previous[slot].xy);
            float localPeak = motion < 0.08 ? GlintSourceLocalPeak(predicted) : 0.0;
            if (localPeak >= releaseGate)
            {
                // At rest, an existing HDR emitter is more reliable than the
                // tile maximum selected by the current TAA phase.
                resolved[slot] = float4(predicted,
                    lerp(previous[slot].z,localPeak,0.10),
                    lerp(previous[slot].w,1.0,0.12));
                resolvedColor[slot] = previousColor[slot];
            }
            else if (SourcePersistence > 0.0)
            {
                float confidence = previous[slot].w * saturate(SourcePersistence);
                if (confidence > 0.12)
                {
                    resolved[slot] = float4(predicted,
                        previous[slot].z, confidence);
                    resolvedColor[slot] = previousColor[slot];
                }
            }
        }
    }

    // Fill genuinely free slots only. Never evict an established source
    // merely because a checkerboard reflection briefly outranks the sun.
    [loop] for (uint slot = 0u; slot < 8u; ++slot)
    {
        if (slot >= MaxSources) break;
        if (resolved[slot].w > 0.10) continue;
        float bestPeak = SourceMinBrightness;
        float bestScore = acquisitionScoreFloor;
        float2 bestUV = float2(-1,-1);
        [loop] for (int y = 0; y < CandidateSize.y; ++y)
        [loop] for (int x = 0; x < CandidateSize.x; ++x)
        {
            float4 c = CandidateTexture.Load(int3(x,y,0));
            if (c.z <= SourceMinBrightness || c.w <= bestScore) continue;
            bool overlaps = false;
            const float candidateGrouping = GlintCandidateGroupingRadius(c.xy, c.z, grouping);
            [unroll] for (int j = 0; j < 8; ++j)
                if (resolved[j].w > 0.10 && distance(c.xy, resolved[j].xy) < candidateGrouping)
                    overlaps = true;
            if (!overlaps)
            {
                bestPeak = c.z;
                bestScore = c.w;
                bestUV = c.xy;
            }
        }
        if (bestUV.x < 0.0) break;
        float3 color = GlintSourceHDRTint(bestUV, bestPeak);
        // Short fade-in keeps single-frame false positives from flashing.
        resolved[slot] = float4(bestUV,bestPeak,0.55);
        resolvedColor[slot] = color;
    }
    // Saturated budgets must not exclude a bright sun indefinitely. A new
    // highlight may challenge the globally weakest slot, or the existing
    // source occupying the *same grouping region* if its peak is substantially
    // stronger and spatially distinct. This avoids the 0.125-UV grouping radius
    // allowing a nearby cloud to block the sun forever.
    int weakestSlot = -1;
    float weakestScore = 1.0e20;
    float trackedRanks[8];
    uint filled = 0u;
    [loop] for (int k=0; k<8; ++k)
    {
        trackedRanks[k] = 0.0;
        if (uint(k) >= MaxSources || resolved[k].w <= 0.10) continue;
        ++filled;
        int2 spot = clamp(int2(resolved[k].xy * float2(BrightSize)), int2(0,0), BrightSize-1);
        float mean = DetectionTexture.Load(int3(spot,0)).r;
        float rank = GlintDetectionRank(resolved[k].z, mean) * max(0.25, resolved[k].w);
        trackedRanks[k] = rank;
        if (rank < weakestScore) { weakestScore = rank; weakestSlot = k; }
    }
    if (filled >= MaxSources && weakestSlot >= 0)
    {
        int incomingVictim = -1;
        float2 incomingUV = float2(-1,-1);
        float incomingPeak = 0.0;
        float incomingScore = acquisitionScoreFloor;
        [loop] for (int y=0; y<CandidateSize.y; ++y)
        [loop] for (int x=0; x<CandidateSize.x; ++x)
        {
            float4 c = CandidateTexture.Load(int3(x,y,0));
            if (c.z < SourceMinBrightness || c.w <= incomingScore) continue;
            int overlapSlot = -1;
            float nearestDistance = 1.0e20;
            [unroll] for (int j=0; j<8; ++j)
            {
                if (uint(j) >= MaxSources || resolved[j].w <= 0.10) continue;
                float d = distance(c.xy,resolved[j].xy);
                if (d < GlintCandidateGroupingRadius(c.xy, c.z, grouping) && d < nearestDistance)
                {
                    nearestDistance = d;
                    overlapSlot = j;
                }
            }
            // A 1-3px peak wobble is not a competing luminous region. The
            // threshold here is deliberately larger than the position deadzone.
            if (overlapSlot >= 0 && nearestDistance <= max(0.025,SourcePositionDeadZone*8.0)) continue;
            int target = overlapSlot >= 0 ? overlapSlot : weakestSlot;
            float requiredRank = trackedRanks[target] * max(SourceReplacementRatio,1.05);
            if (c.w <= requiredRank) continue;
            incomingUV = c.xy;
            incomingPeak = c.z;
            incomingScore = c.w;
            incomingVictim = target;
        }
        if (incomingVictim >= 0)
        {
            float4 prev = previousChallenge[incomingVictim];
            // Challenger state is also screen-space history. Compensate for
            // camera rotation so a real sun is not seen as a new challenger
            // on each moving frame and never reaches confirmation.
            float2 predictedChallenger = GlintReprojectSourceUV(prev.xy);
            float count = distance(incomingUV,predictedChallenger) < max(0.01,grouping*0.25)
                ? prev.w + 1.0 : 1.0;
            if (count >= float(max(SourceReplacementFrames,2u)))
            {
                resolved[incomingVictim] = float4(incomingUV,incomingPeak,0.55);
                resolvedColor[incomingVictim] = GlintSourceHDRTint(incomingUV,incomingPeak);
            }
            else
            {
                resolvedChallenge[incomingVictim] = float4(incomingUV,incomingScore,count);
            }
        }
    }
    [unroll] for (int k = 0; k < 8; ++k)
    {
        SourcesOutput[int2(k,0)] = resolved[k];
        SourcesOutput[int2(k,1)] = float4(resolvedColor[k],1.0);
        SourcesOutput[int2(k,2)] = resolvedChallenge[k];
    }
}

// Authoring axis: +1 follows the source and -1 is reflected across the center.
// This operates on the entire HDR field, without CPU source enumeration.
float2 GlintElementSourceUV(float2 outUV, float axis)
{
    float safeAxis = (axis < 0.0 ? -1.0 : 1.0) * max(abs(axis), 0.05);
    return 0.5 + (outUV - 0.5) / safeAxis;
}

float2 GlintRotate2(float2 v, float angle)
{
    float c = cos(angle);
    float s = sin(angle);
    return float2(v.x * c - v.y * s, v.x * s + v.y * c);
}

float3 GlintRadialField(float2 sourceUV, float radius, float aspectScale)
{
    float3 sum = 0.0;
    [unroll] for (int j = 0; j < 8; ++j)
    {
        float angle = (6.28318530718 / 8.0) * j;
        float2 delta = float2(cos(angle), sin(angle)) * radius;
        delta.x *= aspectScale;
        sum += GlintSampleBright(sourceUV + delta);
    }
    return sum * (1.0 / 8.0);
}

float3 GlintEvaluateAuthored(float2 uv, FGlintRuntimeElement element)
{
    uint kind = (uint)round(element.Geometry.x);
    float axis = element.Geometry.y;
    float size = max(element.Geometry.z, 0.05);
    float rotation = element.Geometry.w;
    float2 src = GlintElementSourceUV(uv - element.Offset.xy, axis);
    float scale = max(abs(axis), 0.05);
    float aspect = float(BrightSize.y) / max(float(BrightSize.x), 1.0);
    float3 value = 0.0;

    if (kind == 0u) // Glow, 5-tap soft field
    {
        float2 o = (0.009 * size / scale) * float2(aspect, 1.0);
        value = GlintSampleBright(src) * 0.30;
        value += (GlintSampleBright(src + float2(o.x, 0)) +
                  GlintSampleBright(src - float2(o.x, 0)) +
                  GlintSampleBright(src + float2(0, o.y)) +
                  GlintSampleBright(src - float2(0, o.y))) * 0.175;
    }
    else if (kind == 1u) // Halo: broad ring plus faint center
    {
        value = GlintRadialField(src, 0.065 * size / scale, aspect) + GlintSampleBright(src) * 0.12;
    }
    else if (kind == 2u) // Ghost: mirrored/following image field
    {
        value = GlintSampleBright(src);
    }
    else if (kind == 3u) // Starburst: 4 crossed lines, rotated as a group
    {
        [unroll] for (int j = 0; j < 4; ++j)
        {
            float angle = rotation + j * (3.14159265359 / 4.0);
            float2 offset = float2(cos(angle) * aspect, sin(angle)) * (0.035 * size / scale);
            value += (GlintSampleBright(src + offset) + GlintSampleBright(src - offset)) * 0.125;
        }
    }
    else if (kind == 4u) // Streak: two-sided line with artist rotation
    {
        float2 direction = GlintRotate2(float2(aspect, 0.0), rotation) * (0.025 * size / scale);
        [unroll] for (int j = -4; j <= 4; ++j)
        {
            value += GlintSampleBright(src + direction * j) * (0.22 / (1.0 + abs(j)));
        }
    }
    else if (kind == 5u) // Iris: central body and narrow diaphragm ring
    {
        value = GlintSampleBright(src) * 0.45 + GlintRadialField(src, 0.027 * size / scale, aspect) * 0.55;
    }
    else if (kind == 6u) // Ring
    {
        value = GlintRadialField(src, 0.042 * size / scale, aspect);
    }
    else if (kind == 7u) // Hoop
    {
        value = GlintRadialField(src, 0.080 * size / scale, aspect) * 0.65;
    }
    else if (kind == 8u) // Multi Iris
    {
        value = GlintRadialField(src, 0.028 * size / scale, aspect) * 0.50;
        value += GlintRadialField(src, 0.050 * size / scale, aspect) * 0.35;
    }
    else if (kind == 9u) // Spike Ball
    {
        [unroll] for (int j = 0; j < 8; ++j)
        {
            float a = rotation + j * 3.14159265359 / 8.0;
            float2 d = float2(cos(a) * aspect, sin(a)) * (0.04 * size / scale);
            value += (GlintSampleBright(src+d)+GlintSampleBright(src-d)) * 0.09;
        }
    }
    // Field mode is a backward-compatible approximation: the more precise
    // authored optical geometry is evaluated against individual GPU sources.
    if (kind >= 13u)
    {
        float2 offset = 0.018 * size / scale * float2(aspect, 1.0);
        value = GlintSampleBright(src) * 0.3;
        value += GlintSampleBright(src + offset) * 0.16;
        value += GlintSampleBright(src - offset) * 0.16;
    }
    return value * element.ColorStrength.rgb * element.ColorStrength.a;
}

// Analytic source-relative optical elements. ScreenOffset is independent of
// optical-axis position; all shapes are radial or angular from their source,
// not magnified copies of a bright HDR rectangle.
float3 GlintEvaluateSourceElement(float2 uv, float4 source, float3 sourceColor, FGlintRuntimeElement element)
{
    if (source.w <= 0.001 || source.z <= 0.0) return float3(0,0,0);
    float2 center = 0.5 + (source.xy - 0.5) * element.Geometry.y + element.Offset.xy;
    float2 delta = uv - center;
    delta.x *= float(BrightSize.x) / max(1.0, float(BrightSize.y));
    float radius = max(0.002, 0.022 * element.Geometry.z);
    // Conservative unrotated bounding sphere before per-element trigonometry,
    // powers, and possible 16-ray loops. Never clips a visible authored shape.
    float bound = 6.0 * radius * max(1.0, element.Shape.z);
    if (dot(delta, delta) > bound * bound) return float3(0,0,0);
    delta = GlintRotate2(delta, -element.Geometry.w);
    delta.x /= max(0.2, element.Shape.z); // artist-controlled anamorphic aspect
    float r = length(delta) / radius;
    if (r > 6.0) return float3(0,0,0);
    uint kind = (uint)round(element.Geometry.x);
    float width = max(0.02, element.Shape.y);
    float falloff = max(0.2, element.Shape.x);
    float rays = clamp(round(element.Shape.w), 2.0, 16.0);
    float sharpness = max(4.0, element.Detail.x);
    float secondary = max(0.0, element.Detail.y);
    float frequency = max(1.0, element.Detail.z);
    float shape = 0.0;
    if (kind == 0u) shape = exp(-falloff*r*r); // Glow
    else if (kind == 1u) shape = exp(-pow((r - 1.25) / width, 2.0)) * 0.7; // Halo
    else if (kind == 2u) shape = exp(-falloff*r*r); // Ghost
    else if (kind == 3u || kind == 9u || kind == 11u) // Starburst, Spike Ball, Sparkle
    {
        [loop] for (int spike=0; spike<16; ++spike)
        {
            if (float(spike) >= rays) break;
            float rayAngle = float(spike) * 3.14159265359 / rays;
            float2 projected = GlintRotate2(delta, rayAngle);
            shape += exp(-sharpness * abs(projected.y) / radius)
                   * exp(-(kind == 11u ? 1.3 : 0.65)*r) * (kind == 9u ? 0.15 : 0.22);
        }
        if (kind == 11u)
        {
            float twinkle = 0.65 + 0.35*cos(atan2(delta.y,delta.x)*frequency);
            shape = shape * twinkle + secondary * exp(-falloff*r*r);
        }
    }
    else if (kind == 4u) // Rotatable anamorphic streak
        shape = exp(-sharpness * abs(delta.y)/radius) * exp(-0.34*abs(delta.x)/radius);
    else if (kind == 5u) // Iris
        shape = (1.0 - smoothstep(0.70,0.90,r))*0.5
            + exp(-pow((r-0.92)/width,2.0))*0.35;
    else if (kind == 6u) // Ring
        shape = exp(-pow((r-1.0)/width,2.0))*0.65;
    else if (kind == 7u) // Hoop
        shape = exp(-pow((r-1.85)/width,2.0))*0.52;
    else if (kind == 8u) // Multi Iris
        shape = exp(-pow((r-0.65)/width,2.0))*0.45
            + secondary*exp(-pow((r-1.05)/width,2.0))*0.35
            + secondary*exp(-pow((r-1.5)/width,2.0))*0.22;
    else if (kind == 10u) // Shimmer: interfered elongated ghost, no frame-time-dependent noise
    {
        float interference = 0.5 + 0.5*cos(delta.x/max(radius,0.001)*frequency);
        shape = exp(-1.3*r*r) * (0.6+secondary*interference);
    }
    else if (kind == 12u) // Caustic: sculpted analytic wave on a broad reflection
    {
        float wave = sin(delta.x/max(radius,0.001)*frequency)
                   * cos(delta.y/max(radius,0.001)*frequency*0.65);
        shape = exp(-1.1*r*r) * max(0.0,0.65+secondary*wave);
    }
    else if (kind == 13u || kind == 14u || kind == 15u) // Polygon iris / blade ring / aperture ghost
    {
        float count = max(3.0, rays);
        float angle = atan2(delta.y,delta.x);
        float sector = 6.2831853 / count;
        float a = angle - sector * floor(angle/sector + 0.5);
        float polygonRadius = cos(3.14159265/count) / max(0.15, cos(a));
        float polygonDistance = r / polygonRadius;
        if (kind == 15u)
            shape = (1.0-smoothstep(0.7, 1.0, polygonDistance)) * exp(-0.35*r);
        else
            shape = exp(-pow((polygonDistance - (kind == 14u ? 1.35 : 0.95))/width,2.0))
                    * (kind == 14u ? 0.62 : 0.75);
    }
    else if (kind == 16u || kind == 17u || kind == 18u) // Cross / vertical / dual streak
    {
        float baseRay = exp(-sharpness*abs(delta.y)/radius) * exp(-0.4*abs(delta.x)/radius);
        float verticalRay = exp(-sharpness*abs(delta.x)/radius) * exp(-0.4*abs(delta.y)/radius);
        if (kind == 16u) shape = 0.5 * (baseRay + verticalRay);
        else if (kind == 17u) shape = baseRay;
        else shape = 0.7 * baseRay + 0.7 * max(0.12,secondary) * verticalRay;
    }
    else if (kind == 19u) // Directional comet/smear
    {
        float head = exp(-falloff*r*r);
        float tail = exp(-sharpness*0.2*abs(delta.y)/radius)
                   * exp(-1.2*max(0.0,delta.x)/radius) * smoothstep(-3.0,0.0,delta.x/radius);
        shape = 0.35*head + 0.28*tail;
    }
    else if (kind == 20u) // Arc reflection, only a segment of the optical ring
    {
        float angle = atan2(delta.y,delta.x);
        float arc = smoothstep(-0.5,0.2,cos(angle - 0.4));
        shape = exp(-pow((r-1.2)/width,2.0))*arc*0.75;
    }
    else if (kind == 21u) // Outer edge ring
        shape = exp(-pow((r-2.0)/width,2.0))*0.44;
    else if (kind == 22u) // Soft disc with gently rolled-off boundary
        shape = (1.0-smoothstep(0.45,1.0,r))*exp(-0.1*falloff*r*r)*0.65;
    else if (kind == 23u) // Wide photographic veil
        shape = exp(-max(0.2,falloff)*r*r*0.28)*0.2;
    else if (kind == 24u) // Petal iris
    {
        float angle = atan2(delta.y,delta.x);
        float petalR = 1.0 + 0.14*max(0.2,secondary)*cos(angle*max(3.0,rays));
        shape = exp(-pow((r-petalR)/width,2.0))*0.65;
    }
    else if (kind == 25u) // Jittered lens dust, stable in screen space (no frame noise).
    {
        float2 cellCoord = delta / max(radius,0.001) * frequency;
        float2 cell = floor(cellCoord);
        float probability = frac(sin(dot(cell, float2(127.1,311.7))) * 43758.5453);
        float2 jitter = frac(sin(float2(dot(cell,float2(269.5,183.3)),
                                  dot(cell,float2(419.2,371.9)))) * 43758.5453);
        float2 local = frac(cellCoord) - (0.2 + 0.6*jitter);
        float speck = exp(-70.0*dot(local,local));
        shape = probability > 0.79 ? speck * exp(-0.24*falloff*r*r) * secondary*0.6 : 0.0;
    }
    // Real ghost reflections are rarely uniformly luminous around a perfect
    // perimeter. Restrained angular variation is deliberate and stable.
    if (kind == 1u || kind == 5u || kind == 6u || kind == 7u || kind == 8u ||
        kind == 13u || kind == 14u || kind == 20u || kind == 21u || kind == 24u)
    {
        float theta = atan2(delta.y, delta.x);
        shape *= 0.90 + 0.10*cos(theta * 3.0 + element.Geometry.y * 1.7);
    }
    float energy = saturate(source.z * 0.25) * source.w;
    return sourceColor * element.ColorStrength.rgb * (element.ColorStrength.a * shape * energy);
}

// Cheap optical families generated around *tracked bright regions*, never by
// mirroring a raster image of the sky. This avoids repeated clouds, checkerboard
// copies and RGB fan-shaped ghost artifacts in the previous automatic renderer.
float3 GlintAutomaticSourceOptics(float2 uv)
{
    float3 total = 0.0;
    float aspect = float(BrightSize.x) / max(1.0, float(BrightSize.y));
    [loop] for (uint slot = 0u; slot < MaxSources; ++slot)
    {
        float4 source = SourcePositions.Load(int3(slot,0,0));
        if (source.w <= 0.12) continue;
        float edge = min(min(source.x,1.0-source.x),min(source.y,1.0-source.y));
        float visibility = SourceEdgeFade > 1e-4 ? saturate(edge/SourceEdgeFade) : 1.0;
        float peakResponse = saturate(source.z/(source.z+2.0));
        float sourceWeight = source.w * visibility * peakResponse;
        if (sourceWeight < 1e-4) continue;
        float3 hdrColor = max(SourcePositions.Load(int3(slot,1,0)).rgb,0.0);
        float3 tint = hdrColor / max(max(hdrColor.r,max(hdrColor.g,hdrColor.b)),0.15);
        float2 opticalAxis = source.xy-0.5;
        if (GhostStrength > 0.0)
        {
            [loop] for (uint i=0u; i<GhostCount; ++i)
            {
                float rank = float(i)+1.0;
                float2 center = 0.5-opticalAxis*(GhostSpacing*rank);
                float2 local = (uv-center)*float2(aspect,1.0);
                float radius = 0.009 + 0.004*rank;
                if (dot(local,local) > (radius*2.2)*(radius*2.2)) continue;
                float chroma = ChromaticShift*0.3*rank;
                float r0 = length(local);
                float redR = length(local-float2(chroma,0));
                float blueR = length(local+float2(chroma,0));
                float width = max(radius*0.23,0.001);
                float3 iris = float3(
                    exp(-pow((redR-radius)/width,2.0)),
                    exp(-pow((r0-radius)/width,2.0)),
                    exp(-pow((blueR-radius)/width,2.0)));
                float disc = exp(-4.5*pow(r0/max(radius,1e-4),2.0));
                float3 optic = iris*0.57 + disc*0.24;
                total += optic * tint * (GhostStrength*sourceWeight*0.24/rank);
            }
        }
        if (StreakStrength > 0.0)
        {
            // Source-centered anamorphic streak. Its spatial extent is bounded
            // and attenuated smoothly, unlike copying source pixels across rows.
            float2 d = (uv-source.xy)*float2(aspect,1.0);
            float lengthScale = 0.14*max(StreakLength,0.25);
            if (abs(d.y) < 0.025 && abs(d.x) < lengthScale*4.0)
            {
                float core = exp(-abs(d.y)/0.0018) * exp(-abs(d.x)/lengthScale);
                float halo = exp(-abs(d.y)/0.0075) * exp(-abs(d.x)/(lengthScale*0.52));
                total += tint * ((0.13*core+0.025*halo)*StreakStrength*sourceWeight);
            }
        }
    }
    return total;
}

[numthreads(8,8,1)]
void GlintGhostCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= uint2(BrightSize))) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(BrightSize);
    float2 dir = uv - 0.5;
    float3 ghost = 0.0;
    float3 streak = 0.0;
    // Old image warp is diagnostic only. New automatic optics use stable,
    // source-relative analytical shapes instead of repeated image fragments.
    if (UseSourceAutomatic == 0u)
    {
    [loop] for (int i = 0; i < 8; ++i)
    {
        if (i >= int(GhostCount) || GhostStrength <= 0.0) break;
        float scale = (i + 1) * GhostSpacing;
        float2 sampleUV = 0.5 - dir * scale;
        float edge = saturate(1.0 - length(dir) * 0.8);
        float2 ca = float2(ChromaticShift * (i + 1), 0.0);
        float3 color = float3(
            GlintSampleBright(sampleUV + ca).r,
            GlintSampleBright(sampleUV).g,
            GlintSampleBright(sampleUV - ca).b);
        ghost += color * edge * (0.20 / (i + 1));
    }
    if (StreakStrength > 0.0)
    {
        [unroll] for (int s = -5; s <= 5; ++s)
        {
            if (s == 0) continue;
            float2 sampleUV = uv + float2(s * 0.018 * StreakLength, 0.0);
            streak += GlintSampleBright(sampleUV) * (0.04 / (1.0 + abs(s)));
        }
    }
    }
    float3 result = UseSourceAutomatic != 0u
        ? GlintAutomaticSourceOptics(uv)
        : ghost*GhostStrength + streak*StreakStrength;
    float3 authored = 0.0;
    if (UseSourcePositions != 0u)
    {
        [loop] for (uint sourceIndex = 0u; sourceIndex < MaxSources; ++sourceIndex)
        {
            float4 source = SourcePositions.Load(int3(sourceIndex, 0, 0));
            if (source.w < 0.001) continue;
            float edgeDistance = min(min(source.x, 1.0-source.x), min(source.y,1.0-source.y));
            float edgeAttenuation = SourceEdgeFade > 0.0001 ? saturate(edgeDistance / SourceEdgeFade) : 1.0;
            source.w *= edgeAttenuation * SourceGain;
            if (source.w <= 0.001) continue;
            // Cached per-source HDR color is preserved for short detection
            // gaps rather than sampled from a possibly empty new bright pass.
            float3 sourceColor = SourcePositions.Load(int3(sourceIndex, 1, 0)).rgb;
            [loop] for (uint e = 0u; e < ElementCount; ++e)
                authored += GlintEvaluateSourceElement(uv, source, sourceColor, FlareElements[e]);
        }
    }
    else
    {
        [loop] for (uint e = 0; e < ElementCount; ++e)
            authored += GlintEvaluateAuthored(uv, FlareElements[e]);
    }
    // Smooth, monotonic HDR shoulder. Does not hard-clip element brightness or
    // change automatic ghosts/streaks; preserves sub-threshold contributions.
    // Zero means no limiter for faithful artistic experimentation.
    if (AuthoredEnergyLimit > 0.001)
    {
        float luminousEnergy = GlintLum(authored);
        authored *= AuthoredEnergyLimit / (AuthoredEnergyLimit + luminousEnergy);
    }
    GhostOutput[id.xy] = float4(result + authored, 1.0);
}

[numthreads(8,8,1)]
void GlintCompositeCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= uint2(FullSize))) return;
    int2 pixel = int2(id.xy);
    float4 source = HDRScene.Load(int3(pixel, 0));
    if (all(pixel >= SourceMin) && all(pixel < SourceMin + SourceSize))
    {
        float2 uv = (float2(pixel - SourceMin) + 0.5) / float2(SourceSize);
        float2 pos = uv * float2(BrightSize) - 0.5;
        int2 i0 = int2(floor(pos));
        float2 fracUV = frac(pos);
        // Composite with transparent black outside the reduced image. Clamping
        // here would also stretch a bright final flare texel over a screen edge.
        int2 p00 = i0;
        int2 p10 = i0 + int2(1, 0);
        int2 p01 = i0 + int2(0, 1);
        int2 p11 = i0 + int2(1, 1);
        float3 a = (all(p00 >= 0) && all(p00 < BrightSize)) ? FlareTexture.Load(int3(p00, 0)).rgb : float3(0,0,0);
        float3 b = (all(p10 >= 0) && all(p10 < BrightSize)) ? FlareTexture.Load(int3(p10, 0)).rgb : float3(0,0,0);
        float3 c = (all(p01 >= 0) && all(p01 < BrightSize)) ? FlareTexture.Load(int3(p01, 0)).rgb : float3(0,0,0);
        float3 d = (all(p11 >= 0) && all(p11 < BrightSize)) ? FlareTexture.Load(int3(p11, 0)).rgb : float3(0,0,0);
        float3 flare = lerp(lerp(a,b,fracUV.x),lerp(c,d,fracUV.x),fracUV.y);
        // Isolation operates at final composite time only: Extract, source
        // selection, color tracking and authored optics still use HDRScene.
        // The resulting image contains Glint plus pure black, never scene RGB.
        source.rgb = (DebugBrightPass != 0u) ? flare :
            ((DebugFlareOnly != 0u) ? flare * FlareIntensity : source.rgb + flare * FlareIntensity);
    }
    // Debug mode 4 shows the smoothed HDR detection field (not scene blur).
    // Full-resolution crosses remain overlaid at the selected source UVs.
    if (DebugSources == 4u && all(pixel >= SourceMin) && all(pixel < SourceMin + SourceSize))
    {
        float2 viewUV = (float2(pixel - SourceMin) + 0.5) / float2(SourceSize);
        int2 DetectionPixel = clamp(int2(viewUV * float2(BrightSize)), int2(0,0), BrightSize-1);
        float filtered = DetectionTexture.Load(int3(DetectionPixel,0)).r;
        float visual = saturate(log2(1.0 + filtered) * 0.17);
        source.rgb = float3(visual,visual,visual);
    }
    // Full-resolution, debug-only overlay. Draw AFTER compositing so a source
    // indicator cannot be confused with an optical element or softened by the
    // quarter-resolution flare upsample. Black outline survives bright skies.
    if (DebugSources != 0u && all(pixel >= SourceMin) && all(pixel < SourceMin + SourceSize))
    {
        [loop] for (uint sourceIndex = 0u; sourceIndex < MaxSources; ++sourceIndex)
        {
            float4 tracked = SourcePositions.Load(int3(sourceIndex, 0, 0));
            if (tracked.w < 0.001) continue;
            float2 marker = float2(SourceMin) + tracked.xy * float2(SourceSize);
            float2 delta = abs((float2(pixel) + 0.5) - marker);
            bool outline = (delta.x <= 3.5 && delta.y <= 15.5) ||
                           (delta.y <= 3.5 && delta.x <= 15.5);
            bool interior = (delta.x <= 1.5 && delta.y <= 12.5) ||
                            (delta.y <= 1.5 && delta.x <= 12.5);
            if (outline) source.rgb = float3(0.0, 0.0, 0.0);
            // Optional confidence diagnostic differentiates a new candidate
            // from a retained source that is fading after a missed sample.
            float3 markerColor = float3(8.0, 0.0, 4.0); // magenta: tracked
            if (DebugSources == 2u)
            {
                if (tracked.w < 0.50) markerColor = float3(0.0, 6.0, 7.0); // cyan: retained
                else if (tracked.w < 0.85) markerColor = float3(8.0, 3.0, 0.0); // amber: new
            }
            else if (DebugSources == 3u)
            {
                // Persistent source-slot identity, independent of confidence.
                // If a cross changes color at the same location, it changed
                // slots; mode 2 alone can conflate that with confidence jitter.
                if (sourceIndex == 0u) markerColor = float3(8,0,3);
                else if (sourceIndex == 1u) markerColor = float3(0,7,8);
                else if (sourceIndex == 2u) markerColor = float3(8,7,0);
                else if (sourceIndex == 3u) markerColor = float3(2,8,0);
                else if (sourceIndex == 4u) markerColor = float3(6,2,8);
                else if (sourceIndex == 5u) markerColor = float3(8,3,0);
                else if (sourceIndex == 6u) markerColor = float3(0,3,8);
                else markerColor = float3(8,8,8);
            }
            if (interior) source.rgb = markerColor;
        }
    }
    SceneOutput[pixel] = source;
}

// Exact same source-relative analytic elements as the runtime renderer.
// This pass uses a single synthetic light rather than scene HDR capture, so
// the editor can preview optics without depending on an open game level.
[numthreads(8,8,1)]
void GlintPreviewCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= uint2(PreviewSize))) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(PreviewSize);
    // The preview source is a position, not an authored optical element.
    // Never add an implicit glowing disc: only the asset's elements render.
    float3 color = float3(0.0,0.0,0.0);
    float4 source = float4(PreviewSourceUV, 5.0, 1.0);
    [loop] for (uint e = 0u; e < PreviewElementCount; ++e)
    {
        color += GlintEvaluateSourceElement(uv, source, PreviewSourceColor.rgb, FlareElements[e]);
    }
    color *= max(PreviewExposure, 0.01);
    color = 1.0 - exp(-max(color, 0.0)); // display transform, not HDR scene tonemapper
    // Alpha-composite the authored flare over the optional reference screenshot
    // in Slate. Encoding normalized RGB + coverage avoids multiplying faint
    // flare colors by alpha twice; runtime HDR compositing is unchanged.
    float coverage = saturate(max(color.r, max(color.g, color.b)));
    PreviewOutput[id.xy] = float4(coverage > 1e-5 ? color / coverage : float3(0,0,0), coverage);
}
